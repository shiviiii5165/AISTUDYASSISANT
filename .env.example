# ========================================================
# LearnByGenie Application Environment Variables Template
# Copy this file to .env and provide your secret credentials
# ========================================================

# Python Runtime & Environment
PYTHON_VERSION=3.11.9
ENVIRONMENT=development

# Supabase (Database & Authentication)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# AI / LLM Providers
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Cashfree Payments (Set to TEST or production keys)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=TEST

# Live Quiz Optimization
LIVE_QUIZ_FREE_TIER_MODE=true

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://prepmind.vercel.app,https://learnbygenie.com,https://aistudyassisant.onrender.com

# Feature Flags & External APIs (Optional)
LESSON_PLANNER_YOUTUBE_ENABLED=true
LESSON_PLANNER_MATERIALS_ENABLED=true
YOUTUBE_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
