{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/*.py": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "backend/**"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "teachgenie.online"
        }
      ],
      "destination": "https://learnbygenie.online/$1",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.teachgenie.online"
        }
      ],
      "destination": "https://learnbygenie.online/$1",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.learnbygenie.online"
        }
      ],
      "destination": "https://learnbygenie.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/auth/:path+",
      "destination": "/api/index.py"
    },
    {
      "source": "/pdfs/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat/:path+",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}